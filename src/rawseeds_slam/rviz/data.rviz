Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Global Options:
    Fixed Frame: odom
    Background Color: 35; 38; 42
    Frame Rate: 20
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Cell Size: 1.0
    Plane Cell Count: 50
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: true
    Show Names: true
  - Class: rviz_default_plugins/LaserScan
    Name: Front scan
    Enabled: true
    Topic:
      Value: /scan_front
      Depth: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Size (Pixels): 3
    Style: Points
    Color Transformer: FlatColor
    Color: 255; 70; 70
  - Class: rviz_default_plugins/LaserScan
    Name: Rear scan (optional)
    Enabled: false
    Topic:
      Value: /scan_rear
      Depth: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Size (Pixels): 3
    Style: Points
    Color Transformer: FlatColor
    Color: 80; 200; 255
  - Class: rviz_default_plugins/Path
    Name: Trajectory
    Enabled: true
    Topic:
      Value: /trajectory
      Depth: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Transient Local
    Color: 255; 140; 0
    Line Style: Lines
    Line Width: 0.04
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top view
      Scale: 8.0
      Target Frame: <Fixed Frame>
      X: 0.0
      Y: 0.0
Window Geometry:
  Width: 1280
  Height: 850
